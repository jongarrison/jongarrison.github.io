aded":"2015-02-12 10:38:28","width":3993},"16326833372":{"albums":[{"id":"72157643911711523","position":2623},{"id":"72157646928615774","position":371}],"bytes":4968531,"camera_position":2623,"comments":[],"description":"","detail":"photos/0045.json","filename":"16326833372_ffddf01b9d_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16326833372/","height":2048,"id":"16326833372","kind":"photo","license":"All Rights Reserved","original":"originals/16326833372/16326833372_ffddf01b9d_o.jpg","sha256":"ca5a5a96caec6b389d534b729a06a4f2e5aa806a2fc1d388b7c60287221f152a","tags":[],"taken":"2014-10-11 17:06:54","title":"IMG_2478","uploaded":"2015-01-20 11:10:54","width":3310},"16327806395":{"albums":[{"id":"72157643911711523","position":2620},{"id":"72157646928615774","position":368}],"bytes":7692437,"camera_position":2620,"comments":[{"author":"25767209@N02","date":"2015-01-20 12:23:51","text":"well framed"}],"description":"","detail":"photos/0045.json","filename":"16327806395_e81bb82b65_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16327806395/","height":1700,"id":"16327806395","kind":"photo","license":"All Rights Reserved","original":"originals/16327806395/16327806395_e81bb82b65_o.jpg","sha256":"c695637b75c9c6481597865135e07ffca4e15b4669bc9d374410ec2ee5d68e6e","tags":[],"taken":"2014-10-11 14:06:34","title":"IMG_2458","uploaded":"2015-01-20 11:27:26","width":3589},"16332987738":{"albums":[{"id":"72157643911711523","position":2888},{"id":"72157646928615774","position":636},{"id":"72157714528998987","position":12}],"bytes":9117499,"camera_position":2888,"comments":[{"author":"16436713@N05","date":"2015-02-13 12:50:16","text":"like this shot ;-)"},{"author":"33251114@N03","date":"2015-02-14 09:03:16","text":"Wow great shot! This guy is taking bicycle touring to a new level."}],"description":"","detail":"photos/0045.json","filename":"16332987738_886f7261bd_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16332987738/","height":4000,"id":"16332987738","kind":"photo","license":"All Rights Reserved","original":"originals/16332987738/16332987738_886f7261bd_o.jpg","sha256":"201fc3c2da1c64f51eff9b18f7b0b1bd1d7df73f88271ee327497d29186e5754","tags":["book14"],"taken":"2014-10-30 18:07:32","title":"IMG_3992","uploaded":"2015-02-13 10:31:37","width":3000},"16333030638":{"albums":[{"id":"72157643911711523","position":2884},{"id":"72157646928615774","position":632},{"id":"72157687398999470","position":65},{"id":"72157707820344824","position":74},{"id":"72157714528998987","position":13}],"bytes":10659908,"camera_position":2884,"comments":[{"author":"105846385@N05","date":"2015-02-13 15:50:04","text":"I really admire what you are doing. What an incredible adventure. I cannot handle more than 2 days camping. Great pictures too."},{"author":"100330886@N04","date":"2015-02-13 17:53:32","text":"Thanks!  It's surprisingly easy and incredibly fun to go for a long ride.  We met all ages and all types while riding.  Check out the gear list from last year: infinitewalkabout.com/gear/touring-cycle-gear-inventory.html"},{"author":"105846385@N05","date":"2015-02-13 18:40:34","text":"I will check it out. I tend to over pack."},{"author":"94951113@N04","date":"2015-02-14 02:46:02","text":"Wow - is that really a bicycle made for four????"},{"author":"19396658@N00","date":"2015-02-14 14:00:53","text":"A splendid quad :)"},{"author":"24775321@N02","date":"2015-02-14 14:58:04","text":"Keep it rubber side down, is my tip.\nGreat pic. Rode a triplet with the kids for a few years, it was a total blast."},{"author":"81644334@N06","date":"2015-02-17 01:38:05","text":"Many thanks for this fantastic shot to my gallery!"},{"author":"100330886@N04","date":"2015-02-18 10:55:58","text":"The bike is a custom Rodriguez.  The web site for the 4 person Cancer fundraising tour is here: www.tandemtourtwo.com/"}],"description":"","detail":"photos/0045.json","filename":"16333030638_e58c8c294a_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16333030638/","height":2148,"id":"16333030638","kind":"photo","license":"All Rights Reserved","original":"originals/16333030638/16333030638_e58c8c294a_o.jpg","sha256":"3827bc56a57da6e5f8d7335e3fc6b86943b890ecd6705f4a9dde1bdbae94f028","tags":["book14"],"taken":"2014-10-30 15:58:26","title":"IMG_3973","uploaded":"2015-02-13 10:37:42","width":3772},"16333095038":{"albums":[{"id":"72157643911711523","position":2877},{"id":"72157646928615774","position":625},{"id":"72157707820344824","position":72}],"bytes":7472623,"camera_position":2877,"comments":[{"author":"57321715@N05","date":"2015-02-18 12:13:31","text":"Gorgeous waterscape!!"}],"description":"","detail":"photos/0045.json","filename":"16333095038_7b3b5ddcea_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16333095038/","height":2167,"id":"16333095038","kind":"photo","license":"All Rights Reserved","original":"originals/16333095038/16333095038_7b3b5ddcea_o.jpg","sha256":"88c5b11dea13269477004e1973ffeb6635293eec6f731b4a1e310fb3d07cb927","tags":[],"taken":"2014-10-30 13:56:48","title":"IMG_3943","uploaded":"2015-02-13 10:46:41","width":3931},"16333103668":{"albums":[{"id":"72157643911711523","position":2876},{"id":"72157646928615774","position":624},{"id":"72157707820344824","position":71}],"bytes":6321430,"camera_position":2876,"comments":[],"description":"","detail":"photos/0045.json","filename":"16333103668_1b3d14068c_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16333103668/","height":2238,"id":"16333103668","kind":"photo","license":"All Rights Reserved","original":"originals/16333103668/16333103668_1b3d14068c_o.jpg","sha256":"02fec9dd1a381e3ffc9b071ba0125e07d34ac39b9139516770f7c0c573be573d","tags":[],"taken":"2014-10-30 13:56:29","title":"IMG_3942","uploaded":"2015-02-13 10:47:49","width":3907},"16333292910":{"albums":[{"id":"72157643911711523","position":2882},{"id":"72157646928615774","position":630},{"id":"72157662632925596","position":93},{"id":"721