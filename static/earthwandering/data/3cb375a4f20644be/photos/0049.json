523","position":3150},{"id":"72157646928615774","position":898}],"bytes":4799403,"camera_position":3150,"comments":[{"author":"95429581@N06","date":"2015-03-10 19:38:33","text":"great shot"},{"author":"87169621@N00","date":"2015-03-11 16:32:06","text":"The new and the old."}],"description":"","detail":"photos/0049.json","filename":"16584024738_9d10226d38_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16584024738/","height":1646,"id":"16584024738","kind":"photo","license":"All Rights Reserved","original":"originals/16584024738/16584024738_9d10226d38_o.jpg","sha256":"40393ed12b4d2005ba7883322d11e45330edee8c94801c19a10a993a50a28e5f","tags":[],"taken":"2014-11-16 14:10:45","title":"IMG_5210","uploaded":"2015-03-09 21:22:18","width":3982},"16584200410":{"albums":[{"id":"72157643911711523","position":3148},{"id":"72157646928615774","position":896}],"bytes":5236413,"camera_position":3148,"comments":[],"description":"","detail":"photos/0049.json","filename":"16584200410_6fbdd64da2_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16584200410/","height":2006,"id":"16584200410","kind":"photo","license":"All Rights Reserved","original":"originals/16584200410/16584200410_6fbdd64da2_o.jpg","sha256":"67b0ec29bb87dc6d68e323bae02a4136698966ea117d4447b5ff3ce99bb186d3","tags":[],"taken":"2014-11-16 13:48:17","title":"IMG_5201","uploaded":"2015-03-09 21:22:49","width":3977},"16585441019":{"albums":[{"id":"72157643911711523","position":3151},{"id":"72157646928615774","position":899},{"id":"72157662068172765","position":60}],"bytes":2225536,"camera_position":3151,"comments":[{"author":"126849102@N06","date":"2015-03-10 20:42:01","text":"love it!"},{"author":"66104887@N06","date":"2015-03-11 08:52:51","text":"Superb shot!"}],"description":"","detail":"photos/0049.json","filename":"16585441019_650d48c05a_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16585441019/","height":1712,"id":"16585441019","kind":"photo","license":"All Rights Reserved","original":"originals/16585441019/16585441019_650d48c05a_o.jpg","sha256":"ea589a42b5017aa66564dd28dcc06286cdab7acc69b0c4005eea34f0700c55ce","tags":["50plus","40plus"],"taken":"2014-11-16 14:11:36","title":"IMG_5211","uploaded":"2015-03-09 21:22:00","width":2159},"16588170647":{"albums":[{"id":"72157643911711523","position":3169},{"id":"72157646928615774","position":917},{"id":"72157707820344824","position":147}],"bytes":12091626,"camera_position":3169,"comments":[{"author":"123798026@N05","date":"2015-03-12 11:37:11","text":"Wow! That fish is huge!"},{"author":"126465970@N03","date":"2015-03-12 13:56:14","text":"Great catch"},{"author":"16436713@N05","date":"2015-03-16 10:28:02","text":"I like to eat the head with soup ;-)"}],"description":"","detail":"photos/0049.json","filename":"16588170647_1cde7fd85c_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16588170647/","height":3000,"id":"16588170647","kind":"photo","license":"All Rights Reserved","original":"originals/16588170647/16588170647_1cde7fd85c_o.jpg","sha256":"74869ace063bce124e9ab2fa1d2cc3c215c609e3857a844bbe909e9fd7f41578","tags":[],"taken":"2014-11-17 14:36:45","title":"IMG_5281","uploaded":"2015-03-12 10:43:13","width":4000},"16590673344":{"albums":[{"id":"72157643911711523","position":3693},{"id":"72157662068172765","position":8},{"id":"72157662632925596","position":78},{"id":"72157663453672647","position":10},{"id":"72157677414327727","position":63}],"bytes":8210143,"camera_position":3693,"comments":[{"author":"94951113@N04","date":"2015-04-20 09:17:09","text":"Nice bike...!  I miss shifters on the down tube.  Except when braking for a junction at the bottom of a hill..."},{"author":"90331155@N07","date":"2015-04-20 13:16:55","text":"Ah! Raleigh! That brand of pedal bike was to Britain, what Chevrolet was to America - everyone had one! (Yeah! An exaggeration, I know). But a super shot of a fine old timer, well done."},{"author":"100330886@N04","date":"2015-04-20 22:07:27","text":"I'm still getting used to the shifters and the handlebars, but I think it is going to be a good bike."},{"author":"7228808@N07","date":"2015-04-29 09:21:36","text":"[https://www.flickr.com/photos/earthwandering] You might try adjusting the bars down a bit so that the ramps and hoods are more level/parallel to the ground."},{"author":"100330886@N04","date":"2015-04-30 23:02:15","text":"Thanks for the advice.  I keep playing around with the adjustments.  I'm so used to either flat bars or my normal bike's h-bars that drops feel unusual."},{"author":"100330886@N04","date":"2015-04-30 23:03:57","text":"Bad news though, actually.  The rims on this bike are not as sturdy as my normal bike's double walls and I was doing one of my funny dismounts where I throw a leg over the back and then stand on one pedal while coming to a stop.  This gently taco'd the back wheel."},{"author":"94951113@N04","date":"2015-05-01 01:54:37","text":"[https://www.flickr.com/photos/earthwandering] That sounds odd.  The wheels should be plenty strong enough to cope with that."},{"author":"100330886@N04","date":"2015-05-04 23:22:59","text":"I agree :)"}],"description":"","detail":"photos/0049.json","filename":"16590673344_a6b9f11da8_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/16590673344/","height":2206,"id":"16590673344","kind":"photo","license":"All Rights Reserved","original":"originals/16590673344/16590673344_a6b9f11da8_o.jpg","sha256":"43f3fae62e637db482bdccb5292692835295b7e7b4442b3211143780490a46f7","tags":["40plus","raleigh","raleigh bicycles"],"taken":"2015-02-28 10:56:59","title":"IMG_8832","uploaded":"2015-04-20 08:40:16","width":3981},"16592930863":{"albums":[{"id":"72157643911711523","position":3692},{"id":"72157662068172765","position":9}],"bytes":6109169,"camera_position":3692,"comments":[{"author":"94951113@N04","date":"2015-04-20 09:17:53","text":"Some boats are so awesomely beautiful, its a crime..."},{"author":"100330886@N04","date":"2015-04-20 09:56:12","t