46:19","width":4000},"19740042293":{"albums":[{"id":"72157643911711523","position":4014},{"id":"72157656867161626","position":4}],"bytes":11277274,"camera_position":4014,"comments":[{"author":"94951113@N04","date":"2015-08-06 22:39:31","text":"Now that looks like a zippy little thing!"},{"author":"100330886@N04","date":"2015-08-06 22:49:34","text":"It's called a Windrider Rave and it flies above the water on foils when it gets up to speed.  The R2AK race was hard on it though:   smallcraftadvisor.com/our-blog/?p=4448"},{"author":"94951113@N04","date":"2015-08-06 23:08:09","text":"[https://www.flickr.com/photos/earthwandering] Wow!  I'd not heard of that race.  That's quite a story and great that the crew escaped unscathed!  A katabatic wind maybe?"},{"author":"100330886@N04","date":"2015-08-07 16:22:34","text":"Interesting, I had to read about Katabatic Winds.  I don't think that was the case here, just the long fetch of the Strait of Georgia North of Vancouver Island.  That race was amazing to follow, I hope they do it again."}],"description":"","detail":"photos/0060.json","filename":"19740042293_30d8510c56_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/19740042293/","height":4000,"id":"19740042293","kind":"photo","license":"All Rights Reserved","original":"originals/19740042293/19740042293_30d8510c56_o.jpg","sha256":"5ac8e344858469632f3a1abb240a6da59a1aed15cd3fbfe90380eb4fc0e39c7f","tags":[],"taken":"2015-06-03 20:19:00","title":"IMG_1588","uploaded":"2015-08-06 20:39:38","width":3000},"19740052703":{"albums":[{"id":"72157643911711523","position":4006},{"id":"72157656867161626","position":12}],"bytes":3682336,"camera_position":4006,"comments":[],"description":"","detail":"photos/0060.json","filename":"19740052703_e2472a198f_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/19740052703/","height":1476,"id":"19740052703","kind":"photo","license":"All Rights Reserved","original":"originals/19740052703/19740052703_e2472a198f_o.jpg","