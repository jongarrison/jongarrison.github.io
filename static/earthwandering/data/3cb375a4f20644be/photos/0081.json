es":3732306,"camera_position":10113,"comments":[],"description":"","detail":"photos/0081.json","filename":"24757691697_29abcb4c53_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24757691697/","height":5386,"id":"24757691697","kind":"photo","license":"All Rights Reserved","original":"originals/24757691697/24757691697_29abcb4c53_o.jpg","sha256":"feee7656722326080ff04a6fa687bf23f176cabfcacf59c6c864892518af8857","tags":["wine","pt winery"],"taken":"2017-09-29 19:11:09","title":"IMG_1895","uploaded":"2018-01-10 22:05:24","width":3591},"24766010487":{"albums":[{"id":"72157643911711523","position":10116}],"bytes":4094789,"camera_position":10116,"comments":[],"description":"","detail":"photos/0081.json","filename":"24766010487_9b50ede107_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24766010487/","height":3648,"id":"24766010487","kind":"photo","license":"All Rights Reserved","original":"originals/24766010487/24766010487_9b50ede107_o.jpg","sha256":"5b8af034ba1cc77587a55d76fc65da96e60b1a665a11b49189905b81b1ab71ff","tags":["port townsend"],"taken":"2017-10-02 17:29:45","title":"IMG_1913","uploaded":"2018-01-11 09:18:49","width":5472},"24769187901":{"albums":[{"id":"72157643911711523","position":5068}],"bytes":4005132,"camera_position":5068,"comments":[],"description":"","detail":"photos/0081.json","filename":"24769187901_7c539e6c48_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24769187901/","height":4000,"id":"24769187901","kind":"photo","license":"All Rights Reserved","original":"originals/24769187901/24769187901_7c539e6c48_o.jpg","sha256":"ccb3caa1d613a560cf59df93d3557a330d1a31e7f087c1f8d007ea2e6bfadcde","tags":["bc","canada","outboard engine maintenance","oil change","Yamaha","9.9"],"taken":"2016-01-23 14:47:03","title":"IMG_8555","uploaded":"2016-02-06 16:59:56","width":3000},"24779470435":{"albums":[{"id":"72157643911711523","position":5046}],"bytes":1552996,"camera_position":5046,"comments":[{"author":"135864077@N04","date":"2016-02-03 17:02:56","text":"making me miss Vic already."},{"author":"100330886@N04","date":"2016-02-03 21:35:45","text":"Aw, man.  :)   The shanty boats make me sad too.  lol.  It was good to hang out with you guys!"},{"author":"135864077@N04","date":"2016-02-04 06:42:29","text":"for some reason they made some sort of a strong poetic impression on me both times i was there. i'd be a tad forlorn if they were gone the next time, hah! -- yeah it really was! :)"},{"author":"100330886@N04","date":"2016-02-05 09:44:46","text":"I like the idea of shanty boat living.  I'm glad they are doing it.  It is kind of funny seeing the community out there grow.  I hope they let it stay.  It's a like a nature reserve for humans."},{"author":"26941526@N00","date":"2016-02-06 18:57:40","text":"A refuge, in every sense.\nSadly, the City is trying to evict them, but currently stalled due to an uncertain legal footing.\nI miss you both!"},{"author":"100330886@N04","date":"2016-02-08 10:28:46","text":"Hopefully back in a couple of weeks!"}],"description":"","detail":"photos/0081.json","filename":"24779470435_cf1363e67d_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24779470435/","height":1515,"id":"24779470435","kind":"photo","license":"All Rights Reserved","original":"originals/24779470435/24779470435_cf1363e67d_o.jpg","sha256":"1fb0cd8c575894004dcbfdf03d82a89ef74b87fec5b3846207b68dd55840b15b","tags":["victoria","bc","canada"],"taken":"2016-01-16 17:06:30","title":"IMG_8416","uploaded":"2016-02-02 12:54:53","width":3169},"24779471195":{"albums":[{"id":"72157643911711523","position":5045}],"bytes":3930774,"camera_position":5045,"comments":[{"author":"10725258@N00","date":"2016-02-05 14:02:45","text":"A most capable-looking steed. \nThose small levers up on the flat part of the bars are extra brake levers? Rigging them in to work with the existing ones on the drops must have been a challenge."},{"author":"100330886@N04","date":"2016-02-06 00:40:48","text":"Inline brake levers are brilliant, but yes you have to run the cables with them in mind."},{"author":"10725258@N00","date":"2016-02-06 07:05:02","text":"Those are new to me, now that I have a name for them I looked them up - brilliant!"}],"description":"","detail":"photos/0081.json","filename":"24779471195_7c94647173_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24779471195/","height":2065,"id":"24779471195","kind":"photo","license":"All Rights Reserved","original":"originals/24779471195/24779471195_7c94647173_o.jpg","sha256":"178afa714fba4f5be6e68299d587b1870e3b2ed1f1630a29624df914a889490b","tags":["victoria","bc","canada","bike","bicycle"],"taken":"2016-01-16 17:03:50","title":"IMG_8415","uploaded":"2016-02-02 12:54:56","width":3498},"24779472485":{"albums":[{"id":"72157643911711523","position":5044}],"bytes":3002956,"camera_position":5044,"comments":[],"description":"","detail":"photos/0081.json","filename":"24779472485_4bfd9e167b_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24779472485/","height":4000,"id":"24779472485","kind":"photo","license":"All Rights Reserved","original":"originals/24779472485/24779472485_4bfd9e167b_o.jpg","sha256":"0f7d858173b31cbc71bd0628fd8352289d7eda4b682fa5761d2a2bef273a4b7b","tags":["victoria","bc","canada","wassail"],"taken":"2016-01-16 16:59:15","title":"IMG_8414","uploaded":"2016-02-02 12:55:00","width":3000},"24783035107":{"albums":[{"id":"72157643911711523","position":10133},{"id":"72157673877793688","position":5}],"bytes":4658334,"camera_position":10133,"comments":[],"description":"","detail":"photos/0081.json","filename":"24783035107_09b623ff83_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/24783035107/","height":4703,"id":"24783035107","kind":"photo","license":"All Rights Reserved","original":"originals/24783035107/24783035107_09b623ff83_o.jpg","sha256":"ee1f006ef55e8edec34d6b56dc644397568e6619d067999943c1382867f473b3","tags":["port townsend","Washington"],"taken":"201