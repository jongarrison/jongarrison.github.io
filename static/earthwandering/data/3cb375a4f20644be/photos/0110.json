www.flickr.com/photos/earthwandering/28941846953/","height":2999,"id":"28941846953","kind":"photo","license":"All Rights Reserved","original":"originals/28941846953/28941846953_35ea92f6a6_o.jpg","sha256":"8f6cc5e1f9057a0ce226f0f299ee860881547ad76739bfe6f7373a4179d28c49","tags":["port townsend","pt","Washington","wa"],"taken":"2016-08-26 16:37:43","title":"IMG_1197","uploaded":"2016-09-09 08:50:51","width":4850},"28941853373":{"albums":[{"id":"72157643911711523","position":6643},{"id":"72157673815062796","position":6}],"bytes":7158985,"camera_position":6643,"comments":[{"author":"118932233@N04","date":"2016-09-09 12:58:50","text":"\u25a3\n.sweet  \u2669\u266a \u2765\n\ua3a7\u15d1\u2119\u2119\ua42e \ua4b3\uffbc\uffbc\uff4b\uffbc\u2115\ua4af"},{"author":"118932233@N04","date":"2016-09-09 13:06:41","text":"Guess what:\nDespite my   72 years, I'm every day on my bike,\nnot an eBike, no !! \nToday it was really hot, \nhad some 70 to 75 kilometers over our hills,\nthis are at times quite steep hills, ... not exhausted now in the evening. . . .that's approx. my daily routine . . \nunless it's too cold or really  heavy rain ...\nLow temperatures  around freezing point and deeper are a problem for my old bones . . ."},{"author":"100330886@N04","date":"2016-09-10 08:32:24","text":"On our long trips we have met people of all ages traveling by bikes.  There are so many aspects of cycling that make people happy.  Glad to hear it is going well for you too.  :)"}],"description":"","detail":"photos/0110.json","filename":"28941853373_69b329e23a_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/28941853373/","height":3639,"id":"28941853373","kind":"photo","license":"All Rights Reserved","original":"originals/28941853373/28941853373_69b329e23a_o.jpg","sha256":"de5abe049c2c474391c81d907a373a7feb61342b816874b6a1560798ae2bee2c","tags":["port townsend","pt","Washington","wa"],"taken":"2016-08-26 16:35:58","title":"IMG_1192","uploaded":"2016-09-09 08:51:04","width":4729},"28