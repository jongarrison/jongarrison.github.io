b525a30d35e7e24e3b0","tags":["Village Vacances Valcartier","Que\u0301bec","winter"],"taken":"2017-01-01 12:53:32","title":"IMG_6371","uploaded":"2017-01-31 07:37:56","width":5356},"32498681976":{"albums":[{"id":"72157643911711523","position":7454}],"bytes":2956517,"camera_position":7454,"comments":[],"description":"","detail":"photos/0130.json","filename":"32498681976_7809aa0959_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/32498681976/","height":3081,"id":"32498681976","kind":"photo","license":"All Rights Reserved","original":"originals/32498681976/32498681976_7809aa0959_o.jpg","sha256":"f58ec41bcb1b843b73f544b096cbba55b2b16536f8ef28c7f4d62df9b49d1498","tags":["Que\u0301bec","winter"],"taken":"2017-01-01 10:40:34","title":"IMG_6204","uploaded":"2017-01-26 10:54:21","width":5141},"32500940365":{"albums":[{"id":"72157643911711523","position":7446}],"bytes":4235317,"camera_position":7446,"comments":[{"author":"90331155@N07","date":"2017-01-25 03:34:45","text":"I guess that's one way to keep your pizza warm! \u263a"},{"author":"94951113@N04","date":"2017-01-25 03:52:24","text":"Some Brit published a whole cookbook for car engine cuisine, the basic idea being that you'd have a cooked meal waiting for you at the end of a long drive.  I must track down a copy."},{"author":"100330886@N04","date":"2017-01-25 06:45:00","text":"Ha!  I'd like to see that book.  I wonder what goes well with a slight taste of engine oil."},{"author":"89119745@N00","date":"2017-02-05 11:01:10","text":"My grandma used to prep meals and tuck them under the hood for us before we went to the cabin up north. We'd arrive to a warm stew...brilliant!"},{"author":"100330886@N04","date":"2017-02-06 17:00:29","text":"Ha!  Did she have a good place to set a sealed pot or something?  Cars should really be designed for this sort of thing."}],"description":"","detail":"photos/0130.json","filename":"32500940365_954c4b2887_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/32500