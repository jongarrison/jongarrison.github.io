teakerne arm","cassel lake","bc","canada","sailing"],"taken":"2017-06-23 16:18:53","title":"IMG_6191","uploaded":"2017-10-01 07:52:15","width":5328},"36723091646":{"albums":[{"id":"72157643911711523","position":8815},{"id":"72157680841154804","position":545}],"bytes":3887145,"camera_position":8815,"comments":[],"description":"","detail":"photos/0150.json","filename":"36723091646_7d580138c8_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36723091646/","height":2460,"id":"36723091646","kind":"photo","license":"All Rights Reserved","original":"originals/36723091646/36723091646_7d580138c8_o.jpg","sha256":"bae1a697c86e6adc35f9bdb8c90d61b012b0f592b3c60225de56b18a58d526ea","tags":["salish sea","Vancouver","vancouver bc","canada","bc","sailng"],"taken":"2017-06-01 22:24:18","title":"IMG_4861","uploaded":"2017-08-23 22:49:56","width":5446},"36723094086":{"albums":[{"id":"72157643911711523","position":8814},{"id":"72157680841154804","position":544}],"bytes":3307918,"camera_position":8814,"comments":[{"author":"90331155@N07","date":"2017-08-23 23:49:54","text":"What's upset the boat owners?"},{"author":"26941526@N00","date":"2017-08-24 13:19:34","text":"[https://www.flickr.com/photos/90331155@N07] Eviction!"},{"author":"100330886@N04","date":"2017-08-24 14:50:46","text":"[https://www.flickr.com/photos/26941526@N00]  is right.  Starting around 2010, they started really cracking down on liveaboards in Vancouver."},{"author":"90331155@N07","date":"2017-08-25 00:36:49","text":"[https://www.flickr.com/photos/earthwandering] Being far from the action, it's hard to know whose right and whose wrong. Still, kicking somebody out of their home is never desirable."},{"author":"100330886@N04","date":"2017-08-25 09:17:15","text":"It's a tough issue.  Waterfronts in cities are precious places, but historically the right to anchor is protected.  It's a complicated issue that it was interesting to learn about.  Vancouver allows people to stay in False Creek for 14 days out of the month.  Which means the liveaboards in Vancouver are more likely to know how to use their boats than in other places like Saltspring Island where the harbor is crowded with boats that potentially haven't had the anchor lifted in years."}],"description":"","detail":"photos/0150.json","filename":"36723094086_d1e98f1e51_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36723094086/","height":2667,"id":"36723094086","kind":"photo","license":"All Rights Reserved","original":"originals/36723094086/36723094086_d1e98f1e51_o.jpg","sha256":"0a88b381a999daeb6772376d1737b0ec6002a292cfd5d3b445027143d26f8864","tags":["salish sea","Vancouver","vancouver bc","canada","bc","sailng"],"taken":"2017-06-01 22:20:20","title":"IMG_4859","uploaded":"2017-08-23 22:50:11","width":4042},"36723096296":{"albums":[{"id":"72157643911711523","position":8813},{"id":"72157680841154804","position":543}],"bytes":3839446,"camera_position":8813,"comments":[],"description":"","detail":"photos/0150.json","filename":"36723096296_be4a3d2de5_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36723096296/","height":2500,"id":"36723096296","kind":"photo","license":"All Rights Reserved","original":"originals/36723096296/36723096296_be4a3d2de5_o.jpg","sha256":"8131b140e4a2ca26c9cee96e497564f753b1a123b9d67063cc2c74172ae62717","tags":["salish sea","Vancouver","vancouver bc","canada","bc","sailng"],"taken":"2017-06-01 22:11:12","title":"IMG_4856","uploaded":"2017-08-23 22:50:27","width":4132},"36723096836":{"albums":[{"id":"72157643911711523","position":8812},{"id":"72157680841154804","position":542}],"bytes":927974,"camera_position":8812,"comments":[],"description":"","detail":"photos/0150.json","filename":"36723096836_fc93809c1d_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36723096836/","height":2855,"id":"36723096836","kind":"photo","license":"All Rights Reserved","original":"originals/36723096836/36723096836_fc93809c1d_o.jpg","sha256":"6a31895e88d124b8320