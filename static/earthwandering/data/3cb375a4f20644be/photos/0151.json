","tags":["sailing","canada","bc","salish sea"],"taken":"2017-06-16 13:48:34","title":"IMG_5600","uploaded":"2017-09-02 08:42:32","width":5365},"36840936481":{"albums":[{"id":"72157643911711523","position":8949},{"id":"72157680841154804","position":679}],"bytes":4554618,"camera_position":8949,"comments":[],"description":"","detail":"photos/0151.json","filename":"36840936481_2606b133ea_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36840936481/","height":2918,"id":"36840936481","kind":"photo","license":"All Rights Reserved","original":"originals/36840936481/36840936481_2606b133ea_o.jpg","sha256":"3ac5ebaf1593247b9639ba4b98ad4ddb1fb9197ec169191b9f9aec39c3f71d5c","tags":["sailing","canada","bc","salish sea"],"taken":"2017-06-16 11:36:13","title":"IMG_5584","uploaded":"2017-09-02 08:43:00","width":5469},"36840947531":{"albums":[{"id":"72157643911711523","position":8947},{"id":"72157680841154804","position":677}],"bytes":4013067,"camera_position":8947,"comments":[],"description":"","detail":"photos/0151.json","filename":"36840947531_59e195db7b_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36840947531/","height":3090,"id":"36840947531","kind":"photo","license":"All Rights Reserved","original":"originals/36840947531/36840947531_59e195db7b_o.jpg","sha256":"46d05b4edcd26f5f768687933ade58964bd2b541b83d20b522a059b700776ba5","tags":["sailing","canada","bc","salish sea"],"taken":"2017-06-16 09:35:07","title":"IMG_5579","uploaded":"2017-09-02 08:43:38","width":4637},"36840999391":{"albums":[{"id":"72157643911711523","position":8939},{"id":"72157680841154804","position":669}],"bytes":6937007,"camera_position":8939,"comments":[{"author":"26941526@N00","date":"2017-09-04 19:32:59","text":"There is a place where the sidewalk ends\nAnd before the street begins,\nAnd there the grass grows soft and white,\nAnd there the sun burns crimson bright,\nAnd there the moon-bird rests from his flight\nTo cool in the peppermint wind.\n\nLet us leave this place where the smoke blows black\nAnd the dark street winds and bends.\nPast the pits where the asphalt flowers grow\nWe shall walk with a walk that is measured and slow,\nAnd watch where the chalk-white arrows go\nTo the place where the sidewalk ends.\n\nYes we'll walk with a walk that is measured and slow,\nAnd we'll go where the chalk-white arrows go,\nFor the children, they mark, and the children, they know\nThe place where the sidewalk ends.\n\nShel Silverstein, 1974 (a very good year, if I may say so myself)"},{"author":"100330886@N04","date":"2017-09-04 22:51:23","text":"Yes!  That's exactly what I had in mind. :)"}],"description":"","detail":"photos/0151.json","filename":"36840999391_a03fa5e4a2_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36840999391/","height":3296,"id":"36840999391","kind":"photo","license":"All Rights Reserved","original":"originals/36840999391/36840999391_a03fa5e4a2_o.jpg","sha256":"ce4913396a2ee179af41174b655566cbdd1f19c37d54c6fe3803ef87af741089","tags":["sailing","canada","bc","salish sea"],"taken":"2017-06-14 19:41:37","title":"IMG_5540","uploaded":"2017-09-02 08:46:07","width":4713},"36843909463":{"albums":[{"id":"72157643911711523","position":9190},{"id":"72157680841154804","position":920}],"bytes":2028759,"camera_position":9190,"comments":[],"description":"","detail":"photos/0151.json","filename":"36843909463_1ce51dab2d_o.jpg","flickr_url":"https://www.flickr.com/photos/earthwandering/36843909463/","height":1533,"id":"36843909463","kind":"photo","license":"All Rights Reserved","original":"originals/36843909463/36843909463_1ce51dab2d_o.jpg","sha256":"10df33717f6a38cdffabe9088adb559952a00d79f114c97d4eefb756dd531555","tags":["sailing","salish sea","canada","bc"],"taken":"2017-06-26 19:52:56","title":"IMG_6744","uploaded":"2017-10-05 07:06:34","width":3577},"36844057193":{"albums":[{"id":"72157643911711523","position":9169},{"id":"72157680841154804","position":899}],"bytes":1873440,"camera_position":9169,"comments":[